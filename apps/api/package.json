{
  "name": "@line-desk/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun --bun tsc --noEmit && bun build src/index.ts --target bun --outdir dist --packages external",
    "start": "bun dist/index.js",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check ."
  },
  "dependencies": {
    "@neondatabase/serverless": "latest",
    "hono": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "prettier": "^3.8.3",
    "@types/bun": "latest"
  },
  "packageManager": "bun@1.4.2"
}
